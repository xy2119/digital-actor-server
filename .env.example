# Copy to .env and fill in values:
#   copy .env.example .env
#
# Min for game-driven + ElevenLabs (recommended on Windows without MSVC):
CEREBRAS_API_KEY=
ELEVENLABS_API_KEY=

# Optional — Qwen-235B via Nebius (VPN-friendly alternative to office GPU):
# NEBIUS_API_KEY=

# Only needed without --langfuse-local:
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Optional override for local prompt root (default: ./.langfuse_prompts):
# LOCAL_LANGFUSE_PATH=
